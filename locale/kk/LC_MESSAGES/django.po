#: apps/accounts/forms.py:12
msgid "Номер телефона"
msgstr "Телефон нөмірі"

#: apps/accounts/forms.py:19 apps/catalog/models/profile.py:34
msgid "Введите казахстанский мобильный номер, например +7 701 123 45 67"
msgstr "Қазақстандық ұялы телефон нөмірін енгізіңіз, мысалы +7 701 123 45 67"

#: apps/accounts/forms.py:24
msgid "Код из SMS"
msgstr "SMS-тегі код"

#: apps/accounts/forms.py:33
msgid "Необходимо ваше согласие, чтобы продолжить"
msgstr "Жалғастыру үшін сіздің келісіміңіз қажет"

#: apps/accounts/otp.py:24
#, python-format
msgid "Код входа в «%(brand)s»: %(code)s"
msgstr "«%(brand)s» жүйесіне кіру коды: %(code)s"

#: apps/accounts/views.py:85 apps/accounts/views.py:101
msgid "Неверный или просроченный код"
msgstr "Код қате немесе мерзімі өтіп кеткен"

#: apps/accounts/views.py:90
msgid "Слишком много неверных попыток. Запросите новый код."
msgstr "Қате әрекет тым көп. Жаңа код сұратыңыз."

#: apps/catalog/links.py:10
#, python-format
msgid ""
"Здравствуйте! Нашёл(ла) вас через «%(brand)s», хочу записаться на "
"консультацию"
msgstr ""
"Сәлеметсіз бе! Сізді «%(brand)s» арқылы таптым, кеңеске жазылғым келеді"

#: apps/catalog/models/profile.py:21
msgid "Очно"
msgstr "Бетпе-бет"

#: apps/catalog/models/profile.py:22
msgid "Выезд на дом"
msgstr "Үйге шығу"

#: apps/catalog/models/profile.py:23
msgid "Онлайн"
msgstr "Онлайн"

#: apps/catalog/models/profile.py:27 templates/core/home.html:62
msgid "Личность подтверждена"
msgstr "Жеке басы расталған"

#: apps/catalog/models/profile.py:28 templates/core/home.html:63
msgid "Образование подтверждено"
msgstr "Білімі расталған"

#: apps/catalog/models/profile.py:29 templates/core/home.html:64
msgid "Квалификация подтверждена"
msgstr "Біліктілігі расталған"

#: apps/catalog/models/profile.py:30 templates/core/home.html:65
msgid "Проверка на безопасность пройдена"
msgstr "Қауіпсіздік тексерісінен өтті"

#: apps/catalog/models/profile.py:39
msgid "Максимальный возраст не может быть меньше минимального"
msgstr "Ең жоғары жас ең төмен жастан кіші болмауы керек"

#: apps/catalog/models/profile.py:102
msgid "Частная практика"
msgstr "Жеке практика"

#: apps/catalog/models/profile.py:103
msgid "Организация"
msgstr "Ұйым"

#: apps/catalog/models/reference.py:51
msgid "есть доказательная база"
msgstr "дәлелді базасы бар"

#: apps/catalog/models/reference.py:52
msgid "ограниченная доказательная база"
msgstr "дәлелді базасы шектеулі"

#: apps/catalog/models/reference.py:53
msgid "нет доказательств эффективности"
msgstr "тиімділігінің дәлелі жоқ"

#: apps/catalog/models/reference.py:54
msgid "педагогическая система, не терапия"
msgstr "педагогикалық жүйе, терапия емес"

#: apps/catalog/models/service.py:61
msgid "Укажите область выезда"
msgstr "Үйге шығу аумағын көрсетіңіз"

#: apps/catalog/models/service.py:65
msgid "У бесплатной услуги не должно быть цены"
msgstr "Тегін қызметтің бағасы болмауы керек"

#: apps/geo/models.py:19
msgid "Область"
msgstr "Облыс"

#: apps/geo/models.py:20 templates/core/home.html:24
msgid "Город"
msgstr "Қала"

#: apps/geo/models.py:21 templates/search/_filters.html:60
msgid "Район"
msgstr "Аудан"

#: apps/geo/models.py:22
msgid "Сельский округ"
msgstr "Ауылдық округ"

#: apps/geo/models.py:66
#, python-format
msgid "Ссылка должна начинаться с %(prefix)s"
msgstr "Сілтеме %(prefix)s деп басталуы керек"

#: apps/questionnaire/questions.py:8
msgid "Оцените следующие утверждения:"
msgstr "Төмендегі тұжырымдарды бағалаңыз:"

#: apps/questionnaire/questions.py:28
msgid "Никогда"
msgstr "Ешқашан"

#: apps/questionnaire/questions.py:29
msgid "Редко"
msgstr "Сирек"

#: apps/questionnaire/questions.py:30
msgid "Иногда"
msgstr "Кейде"

#: apps/questionnaire/questions.py:31
msgid "Часто"
msgstr "Жиі"

#: apps/questionnaire/questions.py:37
msgid ""
"Данный опросник предназначен для выявления индивидуальных особенностей "
"развития ребёнка, определения его сильных сторон и областей, в которых ему "
"требуется дополнительная помощь."
msgstr ""
"Бұл сауалнама баланың дамуындағы жеке ерекшеліктерді анықтауға, оның күшті "
"жақтарын және қосымша көмек қажет салаларды айқындауға арналған."

#: apps/questionnaire/questions.py:38
msgid ""
"Пожалуйста, внимательно прочитайте каждый вопрос и выберите наиболее "
"подходящий вариант ответа."
msgstr "Өтінеміз, әр сұрақты мұқият оқып, ең қолайлы жауап нұсқасын таңдаңыз."

#: apps/questionnaire/questions.py:53
msgid "Речевое развитие и коммуникация"
msgstr "Сөйлеу тілінің дамуы және коммуникация"

#: apps/questionnaire/questions.py:54
msgid "Ребёнок понимает обращённую к нему речь."
msgstr "Бала өзіне қаратылған сөзді түсінеді."

#: apps/questionnaire/questions.py:55
msgid "Выполняет простые устные инструкции."
msgstr "Қарапайым ауызша нұсқауларды орындайды."

#: apps/questionnaire/questions.py:56
msgid "Выполняет инструкции из двух-трёх действий."
msgstr "Екі-үш әрекеттен тұратын нұсқауларды орындайды."

#: apps/questionnaire/questions.py:57
msgid "Использует речь для выражения своих потребностей."
msgstr "Өз қажеттіліктерін білдіру үшін сөйлеуді қолданады."

#: apps/questionnaire/questions.py:58
msgid "Может самостоятельно составить предложение."
msgstr "Өз бетінше сөйлем құрай алады."

#: apps/questionnaire/questions.py:59
msgid "Может поддержать диалог."
msgstr "Диалогты жалғастыра алады."

#: apps/questionnaire/questions.py:60
msgid "Правильно произносит большинство звуков."
msgstr "Дыбыстардың көпшілігін дұрыс айтады."

#: apps/questionnaire/questions.py:61
msgid "Различает и правильно использует слова по смыслу."
msgstr "Сөздерді мағынасына қарай ажыратып, дұрыс қолданады."

#: apps/questionnaire/questions.py:62
msgid "Может пересказать услышанный рассказ или событие."
msgstr "Естіген әңгімесін немесе оқиғаны қайталап айтып бере алады."

#: apps/questionnaire/questions.py:63
msgid "Может самостоятельно рассказать о своих желаниях и переживаниях."
msgstr "Өз қалаулары мен сезімдері туралы өз бетінше айтып бере алады."

#: apps/questionnaire/questions.py:64
msgid "Использует жесты, указание или альтернативные способы коммуникации."
msgstr ""
"Ымдауды, нұсқап көрсетуді немесе коммуникацияның балама тәсілдерін қолданады."

#: apps/questionnaire/questions.py:65
msgid "Ребёнку трудно выразить свои мысли словами."
msgstr "Балаға өз ойын сөзбен жеткізу қиын."

#: apps/questionnaire/questions.py:67
msgid "Познавательное развитие"
msgstr "Танымдық даму"

#: apps/questionnaire/questions.py:68
msgid "Ребёнок может удерживать внимание на одном задании."
msgstr "Бала зейінін бір тапсырмада ұстай алады."

#: apps/questionnaire/questions.py:69
msgid "Может самостоятельно выполнять задания без постоянной помощи взрослого."
msgstr "Ересектің тұрақты көмегінсіз тапсырмаларды өз бетінше орындай алады."

#: apps/questionnaire/questions.py:70
msgid "Запоминает новую информацию."
msgstr "Жаңа ақпаратты есте сақтайды."

#: apps/questionnaire/questions.py:71
msgid "Может вспомнить ранее изученный материал."
msgstr "Бұрын оқып-үйренген материалды еске түсіре алады."

#: apps/questionnaire/questions.py:72
msgid "Различает цвета, формы и величины."
msgstr "Түстерді, пішіндерді және шамаларды ажыратады."

#: apps/questionnaire/questions.py:73
msgid "Ориентируется в пространстве (право, лево, верх, низ)."
msgstr "Кеңістікте бағдарлай алады (оң, сол, жоғары, төмен)."

#: apps/questionnaire/questions.py:74
msgid "Ориентируется во времени (вчера, сегодня, завтра, времена года)."
msgstr "Уақытта бағдарлай алады (кеше, бүгін, ертең, жыл мезгілдері)."

#: apps/questionnaire/questions.py:75
msgid "Умеет сравнивать предметы и находить отличия."
msgstr "Заттарды салыстырып, айырмашылықтарын таба алады."

#: apps/questionnaire/questions.py:76
msgid "Может классифицировать предметы по определённым признакам."
msgstr "Заттарды белгілі бір белгілері бойынша топтастыра алады."

#: apps/questionnaire/questions.py:77
msgid "Понимает причинно-следственные связи."
msgstr "Себеп-салдарлық байланыстарды түсінеді."

#: apps/questionnaire/questions.py:78
msgid "Может решать простые логические задачи."
msgstr "Қарапайым логикалық есептерді шеше алады."

#: apps/questionnaire/questions.py:79
msgid "Испытывает трудности при усвоении новых знаний."
msgstr "Жаңа білімді меңгеруде қиындықтарға тап болады."

#: apps/questionnaire/questions.py:80
msgid "Быстро забывает ранее изученный материал."
msgstr "Бұрын оқып-үйренген материалды тез ұмытады."

#: apps/questionnaire/questions.py:82
msgid "Эмоциональное развитие и поведение"
msgstr "Эмоционалдық даму және мінез-құлық"

#: apps/questionnaire/questions.py:83
msgid "Ребёнок умеет контролировать свои эмоции."
msgstr "Бала өз эмоцияларын басқара алады."

#: apps/questionnaire/questions.py:84
msgid "Спокойно реагирует на отказ или запрет."
msgstr "Өтініші орындалмағанда немесе тыйым салынғанда сабыр сақтайды."

#: apps/questionnaire/questions.py:85
msgid "Может самостоятельно справляться с неудачами."
msgstr "Сәтсіздіктерді өз бетінше жеңе алады."

#: apps/questionnaire/questions.py:86
msgid "Принимает изменения привычного распорядка."
msgstr "Үйреншікті күн тәртібінің өзгеруін қабылдайды."

#: apps/questionnaire/questions.py:87
msgid "Может ждать своей очереди."
msgstr "Өз кезегін күте алады."

#: apps/questionnaire/questions.py:88
msgid "Соблюдает правила и договорённости."
msgstr "Ережелер мен уағдаластықтарды сақтайды."

#: apps/questionnaire/questions.py:89
msgid "Может длительное время заниматься одним видом деятельности."
msgstr "Бір іс-әрекет түрімен ұзақ уақыт айналыса алады."

#: apps/questionnaire/questions.py:90
msgid "Проявляет агрессию по отношению к окружающим."
msgstr "Айналасындағыларға агрессия танытады."

#: apps/questionnaire/questions.py:91
msgid "Часто возникают истерики или эмоциональные срывы."
msgstr "Жиі истерикаға түседі немесе эмоциясын ұстай алмай қалады."

#: apps/questionnaire/questions.py:92
msgid "Может причинять вред себе (бьёт себя, кусает, ударяется)."
msgstr ""
"Өзіне зиян келтіруі мүмкін (өзін ұрады, тістейді, басын немесе денесін "
"заттарға соғады)."

#: apps/questionnaire/questions.py:93
msgid "Проявляет повторяющиеся действия или движения."
msgstr "Қайталанатын әрекеттер немесе қимылдар байқалады."

#: apps/questionnaire/questions.py:94
msgid "Трудно переключается с одного занятия на другое."
msgstr "Бір іс-әрекеттен екіншісіне ауысуы қиын."

#: apps/questionnaire/questions.py:96
msgid "Социальное взаимодействие"
msgstr "Әлеуметтік өзара әрекеттестік"

#: apps/questionnaire/questions.py:97
msgid "Ребёнок самостоятельно вступает в контакт со взрослыми."
msgstr "Бала ересектермен өз бетінше байланысқа түседі."

#: apps/questionnaire/questions.py:98
msgid "Инициирует общение со сверстниками."
msgstr "Құрдастарымен қарым-қатынасты өзі бастайды."

#: apps/questionnaire/questions.py:99
msgid "Проявляет интерес к совместным играм."
msgstr "Бірлескен ойындарға қызығушылық танытады."

#: apps/questionnaire/questions.py:100
msgid "Умеет играть по правилам."
msgstr "Ереже бойынша ойнай алады."

#: apps/questionnaire/questions.py:101
msgid "Понимает эмоции других людей."
msgstr "Басқа адамдардың эмоцияларын түсінеді."

#: apps/questionnaire/questions.py:102
msgid "Может обратиться за помощью."
msgstr "Көмек сұрай алады."

#: apps/questionnaire/questions.py:103
msgid "Умеет делиться игрушками и предметами."
msgstr "Ойыншықтарымен және заттарымен бөлісе алады."

#: apps/questionnaire/questions.py:104
msgid "Поддерживает зрительный контакт в естественных ситуациях общения."
msgstr "Табиғи қарым-қатынас жағдайларында көзбен байланысты сақтайды."

#: apps/questionnaire/questions.py:105
msgid "Проявляет интерес к окружающим людям."
msgstr "Айналасындағы адамдарға қызығушылық танытады."

#: apps/questionnaire/questions.py:106
msgid "Предпочитает находиться в одиночестве."
msgstr "Жалғыз болуды қалайды."

#: apps/questionnaire/questions.py:107
msgid "Испытывает трудности при взаимодействии с другими детьми."
msgstr "Басқа балалармен өзара әрекеттесуде қиындықтарға тап болады."

#: apps/questionnaire/questions.py:109
msgid "Двигательное развитие и физическая активность"
msgstr "Қимыл-қозғалыс дамуы және дене белсенділігі"

#: apps/questionnaire/questions.py:110
msgid "Ребёнок уверенно ходит, бегает и прыгает."
msgstr "Бала сенімді түрде жүреді, жүгіреді және секіреді."

#: apps/questionnaire/questions.py:111
msgid "Хорошо сохраняет равновесие."
msgstr "Тепе-теңдікті жақсы сақтайды."

#: apps/questionnaire/questions.py:112
msgid "Может выполнять движения по показу взрослого."
msgstr "Ересектің көрсетуі бойынша қимылдарды орындай алады."

#: apps/questionnaire/questions.py:113
msgid "Координирует движения рук и ног."
msgstr "Қол мен аяқ қимылдарын үйлестіреді."

#: apps/questionnaire/questions.py:114
msgid "Может ловить и бросать мяч."
msgstr "Допты қағып алып, лақтыра алады."

#: apps/questionnaire/questions.py:115
msgid "Испытывает трудности при выполнении физических упражнений."
msgstr "Дене жаттығуларын орындауда қиындықтарға тап болады."

#: apps/questionnaire/questions.py:116
msgid "Быстро утомляется при физической нагрузке."
msgstr "Дене жүктемесінде тез шаршайды."

#: apps/questionnaire/questions.py:117
msgid "Наблюдается неловкость движений."
msgstr "Қимылдарында ебедейсіздік байқалады."

#: apps/questionnaire/questions.py:118
msgid ""
"Испытывает трудности с мелкой моторикой (застёгивание пуговиц, использование "
"ножниц, рисование)."
msgstr ""
"Ұсақ моторикада қиындықтарға тап болады (түйме салу, қайшы қолдану, сурет "
"салу)."

#: apps/questionnaire/questions.py:119
msgid "Избегает подвижных игр и физических упражнений."
msgstr "Қимылды ойындар мен дене жаттығуларынан қашқақтайды."

#: apps/questionnaire/questions.py:121
msgid "Навыки самообслуживания и самостоятельность"
msgstr "Өзіне-өзі қызмет көрсету дағдылары және дербестік"

#: apps/questionnaire/questions.py:122
msgid "Самостоятельно одевается и раздевается."
msgstr "Өз бетінше киінеді және шешінеді."

#: apps/questionnaire/questions.py:123
msgid "Самостоятельно принимает пищу."
msgstr "Өз бетінше тамақтанады."

#: apps/questionnaire/questions.py:124
msgid "Пользуется туалетом без помощи взрослого."
msgstr "Ересектің көмегінсіз дәретханаға барады."

#: apps/questionnaire/questions.py:125
msgid "Соблюдает правила личной гигиены."
msgstr "Жеке гигиена ережелерін сақтайды."

#: apps/questionnaire/questions.py:126
msgid "Может самостоятельно организовать простые бытовые действия."
msgstr "Қарапайым тұрмыстық әрекеттерді өз бетінше ұйымдастыра алады."

#: apps/questionnaire/questions.py:127
msgid "Убирает за собой игрушки и личные вещи."
msgstr "Ойыншықтары мен жеке заттарын өзі жинастырады."

#: apps/questionnaire/questions.py:128
